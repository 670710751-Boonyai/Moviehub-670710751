# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของตัวเอง (ไฟล์ .env จะไม่ถูก commit)
# ตัวแปรต้องขึ้นต้นด้วย REACT_APP_ เท่านั้น CRA ถึงจะส่งให้โค้ดฝั่งเบราว์เซอร์
# แก้ไฟล์นี้แล้วต้องหยุดและรัน npm start ใหม่

# API Key v3 ของ TMDB
REACT_APP_TMDB_KEY=

# Stage 6: copy to .env.local (ignored by git). REACT_APP_API_URL must be the Go API origin.
# When React and Go run on the SAME local machine: http://localhost:8080
# In Codespaces or Vercel, use your REAL reachable HTTPS API/forwarded-port URL instead.
# Empty value means relative /api requests through the CRA proxy set in package.json.
# If you change this value, restart npm start (or redeploy Vercel).
# The Go server must put your React page's EXACT origin in ALLOWED_ORIGINS.
REACT_APP_API_URL=
